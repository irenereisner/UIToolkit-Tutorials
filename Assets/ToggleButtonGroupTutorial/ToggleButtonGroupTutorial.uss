#menu {
    margin-top: 120px;
}

.unity-toggle-button-group {
    border-radius: 8px;
    border-width: 3px;
    border-color: rgb(26, 26, 26);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Bangers/Bangers-Regular.ttf?fileID=12800000&guid=3ee1e30d7dc834f218e91b8298c311c1&type=3#Bangers-Regular");
    width: 600px;
    height: 300px;
    margin: 20px;
    align-self: center;
    align-items: stretch;
    background-image: url("../Content/Textures/comic-bg.png");
}

.unity-toggle-button-group .unity-button {
    background-color: rgba(243, 240, 229, 0.5);
    font-size: 20px;
    color: rgb(26, 26, 26);
    text-shadow: 2px 2px 0 rgb(255, 255, 255);
    margin: 0;
    padding: 0;
    flex-grow: 1;
    border-width: 0;
    flex-basis: 20%;
}

.unity-toggle-button-group .unity-button-group__button--left,
.unity-toggle-button-group .unity-button-group__button--mid {
    border-right-width: 2px;
    border-color: rgb(26, 26, 26);
}

.unity-toggle-button-group .unity-button:hover {
    background-color: rgba(248, 224, 115, 0.5);
    -unity-font-style: bold;
    padding-top: 10px;
}

.unity-toggle-button-group .unity-button:checked {
    background-color: transparent;
}
