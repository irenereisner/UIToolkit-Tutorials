.card {
    background-color: rgb(15, 15, 15);
    width: 200px;
    height: 200px;
    margin: 20px;
    overflow: hidden;
    justify-content: center;
}

.card .card-blob {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background-image: url("../Content/Textures/green-gradient.png");
    background-repeat: repeat;
    transition-property: width, height;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out-back;
}


.card-left-bottom .card-blob {
    left: -100px;
    bottom: -100px;
}

.card-right-bottom .card-blob {
    right: -100px;
    bottom: -100px;
    rotate: 90deg;
}

.card-left-top .card-blob {
    left: -100px;
    top: -100px;
    rotate: 180deg;
}

.card-right-top .card-blob {
    right: -100px;
    top: -100px;
    rotate: 270deg;
}



.card:hover .card-blob {
    width: 360px;
    height: 360px;
}

.card .unity-label {
    color: rgb(54, 173, 189);
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    transition-property: color;
    transition-delay: 0.2s;
    transition-duration: 0.3s;
}

.card:hover .unity-label {
    color: rgb(255, 255, 255);
}



.button {
    width: 120px;
    border-width: 0;
    background-color: transparent;
    padding: 0;
    flex-direction: row;
    align-items: center;
}

.button-circle {
    position: absolute;
    width: 24px;
    height: 24px;
    background-color: black;
    border-radius: 12px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out-cubic;
}

.button:hover .button-circle {
    width: 100%;
}

.button-text {
    margin: 8px 8px 8px 32px;
    transition-property: color;
    transition-delay: 0.1s;
    transition-duration: 0.1s;
    font-size: 12px;
}

.button:hover .button-text {
    color: rgb(225, 225, 225);
}

.button-icon {
    width: 18px;
    height: 18px;
    margin: 3px 0 0 -2px;
    background-image: url("../Content/Textures/arrow-1.png");
    transition-property: margin;
    transition-duration: 0.2s;
}

.button:hover .button-icon {
    background-image: url("../Content/Textures/arrow-2.png");
    margin: 3px 0 0 5px;
}

.blur-image {
    width: 300px;
    height: 200px;
    justify-content: center;
}

.blur-image .unity-image {
    position: absolute;
    width: 100%;
    height: 100%;
    transition-property: filter;
    transition-duration: 0.2s;
}

.blur-image-light:hover .unity-image {
    filter: blur(2px);
}

.blur-image-medium:hover .unity-image {
    filter: blur(4px);
}

.blur-image-strong:hover .unity-image {
    filter: blur(8px);
}

.blur-image .unity-label {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity, font-size;
    transition-duration: 0.2s;
}

.blur-image:hover .unity-label {
    opacity: 1;
    font-size: 18px;
}
