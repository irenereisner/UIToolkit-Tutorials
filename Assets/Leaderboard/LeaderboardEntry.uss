#player {
    flex-direction: row;
    margin: 4px;
    padding: 5px;
    border-width: 1px;
    border-color: rgb(0, 110, 155);
    border-radius: 2px;
    justify-content: space-around;
    align-items: center;
}

#player-portrait {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: rgba(151, 142, 234, 0.5);
    overflow: hidden;
    margin: 0 6px 0 10px;
}

#player-name {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(170, 235, 255);
    flex-grow: 1;
}

#player-points {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(0, 195, 245);
}

#player-position {
    position: absolute;
    font-size: 10px;
    left: -7px;
    top: -7px;
    border-radius: 50%;
    background-color: rgb(0, 110, 155);
    width: 20px;
    height: 20px;
    color: rgb(170, 235, 255);
    -unity-text-align: middle-center;
}


.unity-collection-view__item,
.unity-collection-view__item--selected,
.unity-collection-view__item:hover
{
    background-color: transparent;
}

.unity-collection-view__item--alternative-background #player {
    background-color: rgba(0, 110, 155, 0.2);
}

